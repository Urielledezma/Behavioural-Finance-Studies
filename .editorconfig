root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 100

[*.md]
# Two trailing spaces are a Markdown line break, used in the report front matter.
trim_trailing_whitespace = false

[*.{yml,yaml,cff}]
indent_size = 2
